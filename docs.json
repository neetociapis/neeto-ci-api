{
  "$schema": "https://mintlify.com/docs.json",
  "name": "NeetoCI API",
  "description": "NeetoCI API docs guide to manage CI/CD pipelines",
  "theme": "mint",
  "colors": {
    "primary": "#10B981",
    "light": "#34D399",
    "dark": "#059669"
  },
  "favicon": "/assets/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://www.neeto.com/neetoci/blog"
      },
      {
        "label": "Help center",
        "href": "https://help.neetoci.com/"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/neetohq",
      "linkedin": "https://www.linkedin.com/company/neeto",
      "youtube": "https://www.youtube.com/channel/UCoQ3Kv2JdZ51WZJ3QFFcI9g",
      "slack": "https://www.launchpass.com/neetohq"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "api/introduction",
              "api/workspace-subdomain",
              "api/authentication",
              "api/response-codes"
            ]
          },
          {
            "group": "CI Jobs",
            "icon": "play",
            "pages": [
              "api/ci-jobs/create"
            ]
          },
          {
            "group": "Team Members",
            "icon": "user-group",
            "pages": [
              "api/team-members/list",
              "api/team-members/get",
              "api/team-members/add",
              "api/team-members/update",
              "api/team-members/remove"
            ]
          },
          {
            "group": "API v1 (Deprecated)",
            "icon": "triangle-exclamation",
            "pages": [
              "api-reference-v1/ci-jobs/trigger"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "icon": "rectangle-terminal",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "cli/introduction",
              "cli/installation",
              "cli/authentication",
              "cli/output-formats",
              "cli/ai-assistants",
              "cli/troubleshooting"
            ]
          },
          {
            "group": "Commands",
            "icon": "terminal",
            "pages": [
              "cli-reference/overview",
              "cli-reference/ci-jobs",
              "cli-reference/debug-sessions",
              "cli-reference/global-env-vars",
              "cli-reference/project-env-vars",
              "cli-reference/projects",
              "cli-reference/utility"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "params": {
      "expanded": "all"
    },
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "all"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "redirects": [
    {
      "source": "/getting-started/introduction",
      "destination": "/api/introduction"
    },
    {
      "source": "/getting-started/workspace-subdomain",
      "destination": "/api/workspace-subdomain"
    },
    {
      "source": "/getting-started/authentication",
      "destination": "/api/authentication"
    },
    {
      "source": "/getting-started/response-codes",
      "destination": "/api/response-codes"
    },
    {
      "source": "/getting-started",
      "destination": "/api/introduction"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/api/:slug*"
    }
  ]
}
