[
  {
    "command": "neetoci ci-jobs",
    "description": "Manage CI jobs",
    "subcommands": [
      {
        "command": "neetoci ci-jobs cancel",
        "description": "Cancel a running CI job"
      },
      {
        "command": "neetoci ci-jobs create",
        "description": "Trigger a new CI job",
        "flags": [
          {
            "name": "branch",
            "type": "string",
            "description": "Branch to run against",
            "required": true
          },
          {
            "name": "commit",
            "type": "string",
            "description": "Commit SHA (defaults to latest on the branch)"
          },
          {
            "name": "project",
            "type": "string",
            "description": "Project name",
            "required": true
          },
          {
            "name": "workflow",
            "type": "string",
            "description": "Workflow name (config file name without .yml)",
            "required": true
          }
        ]
      },
      {
        "command": "neetoci ci-jobs list",
        "description": "List CI jobs for a project",
        "flags": [
          {
            "name": "branch",
            "type": "string",
            "description": "Filter by branch name"
          },
          {
            "name": "page",
            "type": "int",
            "default": "0",
            "description": "Page number"
          },
          {
            "name": "page-size",
            "type": "int",
            "default": "0",
            "description": "Items per page (max 100)"
          },
          {
            "name": "project",
            "type": "string",
            "description": "Project name",
            "required": true
          }
        ]
      },
      {
        "command": "neetoci ci-jobs logs",
        "description": "Show the per-pod logs of a CI job",
        "flags": [
          {
            "name": "project",
            "type": "string",
            "description": "Project name",
            "required": true
          }
        ]
      },
      {
        "command": "neetoci ci-jobs rerun",
        "description": "Rerun a CI job"
      },
      {
        "command": "neetoci ci-jobs resource-metrics",
        "description": "View a CI job's per-pod CPU and memory metrics (for debugging OOM/perf)",
        "flags": [
          {
            "name": "end",
            "type": "string",
            "description": "Window end (Unix seconds)"
          },
          {
            "name": "metric",
            "type": "string",
            "description": "Filter metric: cpu, memory, or all (default all)"
          },
          {
            "name": "pod",
            "type": "string",
            "description": "Only include this pod"
          },
          {
            "name": "start",
            "type": "string",
            "description": "Window start (Unix seconds)"
          },
          {
            "name": "step",
            "type": "int",
            "default": "0",
            "description": "Resolution in seconds"
          },
          {
            "name": "summary",
            "type": "bool",
            "default": "false",
            "description": "Return peak values only (omit time-series)"
          }
        ]
      },
      {
        "command": "neetoci ci-jobs show",
        "description": "Show a CI job"
      }
    ]
  },
  {
    "command": "neetoci debug-sessions",
    "description": "Manage CI job debug sessions",
    "subcommands": [
      {
        "command": "neetoci debug-sessions create",
        "description": "Start a debug session for a finished CI job",
        "flags": [
          {
            "name": "duration",
            "type": "int",
            "default": "1800",
            "description": "Session duration in seconds (300-3600)"
          },
          {
            "name": "job",
            "type": "string",
            "description": "CI job ID",
            "required": true
          }
        ]
      },
      {
        "command": "neetoci debug-sessions show",
        "description": "Show a debug session"
      },
      {
        "command": "neetoci debug-sessions ssh-key",
        "description": "Show the SSH private key for a debug session"
      },
      {
        "command": "neetoci debug-sessions stop",
        "description": "Stop a debug session"
      }
    ]
  },
  {
    "command": "neetoci doctor",
    "description": "Check CLI health and connectivity"
  },
  {
